# ===== Git仓库接入体检工具 - 环境变量模板 =====
# 复制此文件为 .env 并填入实际值，.env 已被 .gitignore 排除

# GitHub Personal Access Token (Classic 或 Fine-grained)
# 用于提升 GitHub API 限流额度（匿名60次/小时 → 认证后5000次/小时）
# 生成方式：GitHub → Settings → Developer settings → Personal access tokens
# 权限要求：公开仓库无需额外 scope，默认 public_repo 即可
GITHUB_TOKEN=your_github_token_here

# Gitee 访问令牌（可选，公开仓库可留空；填写后额度更高、更稳定）
GITEE_TOKEN=

# DeepSeek API Key（可选）
# 用于生成「AI 接入建议」；留空时 AI 模块自动禁用，基础扫描功能不受影响
# 获取方式：https://platform.deepseek.com/ → API Keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GITEE_TOKEN=your_gitee_token_here
